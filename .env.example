# Run npm run setup:local to reuse the local Sales Floor provider credentials.
# Keep all these variables server-only. Never prefix them with NEXT_PUBLIC_.
# The database name is part of this URI; no separate database variable is used.
MONGOURI=mongodb+srv://USER:PASSWORD@HOST/booran_sms_lab?retryWrites=true&w=majority
MOBILEMESSAGE_USERNAME=
MOBILEMESSAGE_PASSWORD=
MOBILEMESSAGE_SENDER_ID=
# Optional preferred reply-capable shared/dedicated sender on the same account.
SMS_LAB_REPLY_SENDER=
# Separate test workspace password, minimum 12 characters.
SMS_LAB_PASSWORD=
# Random session/code signing key, minimum 32 characters.
SMS_LAB_SESSION_SECRET=
# Public HTTPS deployment/custom domain. Required for verification links on Vercel.
# Local localhost links are usable only on this computer, not on a phone.
APP_URL=http://localhost:3100
PORT=3100
